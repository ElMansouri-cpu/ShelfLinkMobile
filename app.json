{
  "expo": {
    "name": "shelflink-pro",
    "slug": "shelflink-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logoShelf.png",
    "userInterfaceStyle": "dark",
    "scheme": "shelflink",
    "splash": {
      "image": "./assets/logoShelf.png",
      "resizeMode": "cover",
      "backgroundColor": "#00162e"
    },
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bgsc.shelflinkpro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoShelf.png",
        "backgroundColor": "#00162e"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "sk.eyJ1IjoieGdoYXNlMTQiLCJhIjoiY21mNWRldDliMDRlbTJtczl0Y3VudHl2dyJ9.keFU2MpGofDIVt6ymthUOA"
        }
      ],
      "expo-localization",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "6cbb85f3-e052-45dc-bd6c-d3d89070df97"
      },
      "router": {}
    },
    "owner": "xghase147"
  }
}