{
  "expo": {
    "name": "SHELFLINK",
    "slug": "SHELFLINK",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_mint.png",
    "userInterfaceStyle": "dark",
    "scheme": "shelflink",
    "splash": {
      "image": "./assets/splash_screen.png",
      "resizeMode": "cover",
      "backgroundColor": "#fff"
    },
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bgsc.shelflink-retailer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_mint.png",
        "backgroundColor": "#48C6A8"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "sk.eyJ1IjoieGdoYXNlMTQiLCJhIjoiY21mNWRldDliMDRlbTJtczl0Y3VudHl2dyJ9.keFU2MpGofDIVt6ymthUOA",
          "RNMapboxMapsPublicToken": "pk.eyJ1IjoieGdoYXNlMTQiLCJhIjoiY21mNDhxMXRxMDB3eTJrczRwZTR5dnlydSJ9.-iWoOkmS7QXZqhqwTMLAAA"
        }
      ],
      "expo-localization",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "2832a91b-ca80-4cc8-ade5-86cec171cdb4"
      },
      "router": {},
      "mapboxAccessToken": "pk.eyJ1IjoieGdoYXNlMTQiLCJhIjoiY21mNDhxMXRxMDB3eTJrczRwZTR5dnlydSJ9.-iWoOkmS7QXZqhqwTMLAAA"
    },
    "owner": "xghase147"
  }
}
